
<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <PackageId>ISU.Redux.Library</PackageId>
    <Version>0.1.0</Version>
    <Authors>Redux Contributors</Authors>
    <Description>A .NET library for computational problems, solvers, verifiers, reductions, and visualizations.</Description>

    <PackageProjectUrl>https://github.com/ReduxISU/Redux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ReduxISU/Redux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>algorithms;redux;computer-science;graph-theory</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
</PropertyGroup>

  <ItemGroup>
    <Compile Include="ReduxClient.cs" />
    <!-- Share interface implementations while excluding API-only files. -->
    <Compile Include="../Interfaces/**/*.cs"
         Exclude="../Interfaces/ComputeWorker.cs;
                  ../Interfaces/SolveWorkerPool.cs;
                  ../Interfaces/DefaultFor.Server.cs" />
    <Compile Include="../Problems/**/*.cs" />
    <Compile Include="../Tools/QasmD3Scheduler.cs" />
    <Compile Include="../Tools/QuantumServerAPI.cs" />
    <Compile Include="../QuantumSolverSettings.cs" />
    <Compile Include="../ProjectSourcePath.cs" />
    <Compile Include="DefaultFor.LibraryDiscovery.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NCalc" Version="7.3.0" />
    <PackageReference Include="SPADE" Version="0.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
</ItemGroup>

</Project>
