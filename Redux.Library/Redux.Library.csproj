
<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <PackageId>Redux.Library</PackageId>
    <Version>1.0.101</Version>
    <Authors>Redux Contributors</Authors>
    <Description>A .NET library for computational problems, solvers, verifiers, reductions, and visualizations.</Description>

    <PackageProjectUrl>https://github.com/prashant9711/Redux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/prashant9711/Redux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>algorithms;redux;computer-science;graph-theory</PackageTags>
</PropertyGroup>

  <ItemGroup>
    <Compile Include="ReduxClient.cs" />
    <Compile Include="../Interfaces/**/*.cs" />
    <Compile Include="../Problems/**/*.cs" />
    <Compile Include="../Tools/QasmD3Scheduler.cs" />
    <Compile Include="../Tools/QuantumServerAPI.cs" />
    <Compile Include="../QuantumSolverSettings.cs" />
    <Compile Include="../ProjectSourcePath.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NCalc" Version="7.2.0" />
    <PackageReference Include="SPADE" Version="0.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

</Project>
