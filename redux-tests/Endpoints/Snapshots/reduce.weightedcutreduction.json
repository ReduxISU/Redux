  "reductionTo": {
    "problemName": "Weighted Cut",
    "formalDefinition": "Weighted Cut = {\u003CG, k\u003E | G is a graph with cut of size k}",
    "problemDefinition": "A weighted cut in an undirected graph is a partition of the graph\u0027s vertices into two complementary sets S and T, and the size of the cut is the sum of edge weights between S and T.",
    "inputDescription": "G, a weighted graph, and k, a target cut weight",
    "outputDescription": "True or False, whether the given edge subset forms a cut of total weight exactly k",
    "source": "Karp, Richard M. Reducibility among combinatorial problems. Complexity of computer computations. Springer, Boston, MA, 1972. 85-103.",
    "sourceFile": "Problems/NPComplete/NPC_WEIGHTEDCUT/WEIGHTEDCUT_Class.cs",
