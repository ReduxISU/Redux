  "reductionFrom": {
    "problemName": "Exact Hitting Set",
    "formalDefinition": "Exact Hitting Set = {\u003CU, S\u003E | U is a set, S is a family of subsets {S_i} of U, and there is a set W subset of U such that, for each i, |W intersect S_i| = 1}.",
    "problemDefinition": "Exact Hitting Set is the problem of finding a set W of elements of U that shares exactly one element with each subset S_i. This is the Hitting Set of Karp (1972, problem 15). It is stricter than the Hitting Set of most later texts, such as Garey and Johnson (SP8), which only requires W to share at least one element with each subset and to have at most k elements.",
    "inputDescription": "U, a universal set, and S, a collection of subsets of U",
    "outputDescription": "True or False, whether a set W exists that shares exactly one element with each subset in S",
    "source": "Karp, Richard M. Reducibility among combinatorial problems. Complexity of computer computations. Springer, Boston, MA, 1972. 85-103.",
    "sourceFile": "Problems/NPComplete/NPC_HITTINGSET/HITTINGSET_Class.cs",
    "wikiName": "",
    "defaultInstance": "({1,2,3,4},{{1,3},{2,3,4},{1,4}})",
    "instance": "({1,2,3,4},{{1,3},{2,3,4},{1,4}})",
    "instanceFormat": "Format: {(U,S) | U is set, S subset {a | a subset U}} Example: ({1,2,3,4},{{1,3},{2,3,4},{1,4}})",
    "certificateFormat": "Format: W subset U | W intersects every subset in S in exactly one element Example: {1,2}",
    "complexityClass": "NPComplete",
    "problemType": "SetsAndPartitions",
    "problemTypes": [
      "SetsAndPartitions"
    ],
    "contributors": [
      "Russell Phillips",
      "Michael Trosper"
    ],
    "defaultSolver": {
      "solverName": "Exact Hitting Set Brute Force",
      "solverDefinition": "This is a brute force solver for Exact Hitting Set. It tests every subset of U and returns the first one that intersects every subset in S in exactly one element.",
      "source": "",
      "sourceFile": "Problems/NPComplete/NPC_HITTINGSET/Solvers/HittingSetBruteForce.cs",
      "contributors": [
        "Russell Phillips"
      ],
      "timerHasExpired": false,
      "solverType": "BruteForce",
      "solverTypes": [
        "BruteForce"
      ],
      "timeComplexity": {
        "Function": "2^n * s * n",
        "Description": ", n = |universalSet|, s = number of subsets in S",
        "VariableNames": [
          "n",
          "s"
        ]
      },
      "spaceComplexity": null,
      "complexityBucket": "Exponential"
    },
