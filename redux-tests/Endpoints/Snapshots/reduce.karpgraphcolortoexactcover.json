  "reductionFrom": {
    "problemName": "Graph Coloring",
    "formalDefinition": "GRAPHCOLORING = {\u003CG,k\u003E | G is a graph that has a k-coloring}",
    "problemDefinition": "An assignment of labels (e.g., colors) to the vertices of a graph such that no two adjacent vertices are of the same label. This is called a vertex coloring.",
    "inputDescription": "G, a graph, and k, the number of colors",
    "outputDescription": "True or False, whether G has a valid k-coloring",
    "source": "Karp, Richard M. Reducibility among combinatorial problems. Complexity of computer computations. Springer, Boston, MA, 1972. 85-103.",
    "sourceFile": "Problems/NPComplete/NPC_GRAPHCOLORING/GRAPHCOLORING_Class.cs",
    "wikiName": "",
    "defaultInstance": "(({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)",
    "instance": "(({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)",
    "instanceFormat": "Format: {((N,E),K) | N is set, E subset N unorderedcross N, K is int} Example: (({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)",
    "certificateFormat": "Format: {c1,...,cK} | color classes partition N, no edge in E has both endpoints in the same class Example: {{a,f},{b,d},{c,e}}",
    "complexityClass": "NPComplete",
