n only letters, digits and \u0027_\u0027. When there are several clauses, each clause with more than one literal must be in parentheses. Each clause has at most 3 literals. Example: (x1 | x2 | x3) \u0026 (!x1 | !x2 | !x3) \u0026 (!x1 | x2 | x3) \u0026 (x1 | !x2 | x3)","certificateFormat":"Comma-separated variable:Boolean pairs, optionally wrapped in parentheses. Booleans must be capitalized True/False (T/F also accepted); \u0027:\u0027 or \u0027=\u0027 may be used as the separator. List every variable you are assigning. Example: (x1:True,x2:False,x3:True)","defaultSolver":{"solverName":"3SAT Backtracking","solverDefinition":"This is a O(2^n) solution algorithm for the 3SAT problem which implements a back tracking algorithm to find an exact assignment boolean assignment of variables to satisfy the problem instance.","source":"","sourceFile":"Problems/NPComplete/NPC_SAT3/Solvers/Sat3BacktrackingSolver.cs","contributors":["David Lindeman","Kaden Marchetti"],"timerHasExpired":false,"solverType":"Backtracking","solverTypes":["Backtracking"],"complexityBucket":"Exponential","timeComplexity":{"Function":"2^n * |phi|","Description":", n = number of variables, |phi| = formula size","VariableNames":["n","phi"]}},"defaultVerifier":{"verifierName":"3SAT Solution Verifier","verifierDefinition":"This is a verifier for 3SAT. It takes the certificate from the user and validates that every clause contains a true literal","source":"","sourceFile":"Problems/NPComplete/NPC_SAT3/Verifiers/SAT3Verifier.cs","contributors":["Kaden Marchetti"],"certificate":""},"defaultVisualization":{"visualizationName":"3SAT Visualization","visualizationDefinition":"This is a default visualization for 3SAT","source":"","sourceFile":"Problems/NPComplete/NPC_SAT3/Visualizations/Sat3DefaultVisualization.cs","contributors":["Kaden Marchetti"],"visualizationType":"BooleanSatisfiability","visualizationTypes":["BooleanSatisfiability"],"pictureType":"GroupedGraph","solver":{"solverName":"3SAT Backtracking","solve