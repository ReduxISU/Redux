  "reductionFrom": {
    "problemName": "3SAT",
    "formalDefinition": "3SAT = {\u03A6 | \u03A6 is a satisfiable Boolean formula in 3CNF}",
    "problemDefinition": "3SAT is the Boolean satisfiability problem restricted to formulas in conjunctive normal form with at most three literals per clause. It asks whether there is an assignment of True/False values to the variables of \u03A6 that makes the whole formula True.",
    "inputDescription": "\u03A6, a boolean formula",
    "outputDescription": "True or False, whether \u03A6 is satisfiable",
    "source": "Karp, Richard M. Reducibility among combinatorial problems. Complexity of computer computations. Springer, Boston, MA, 1972. 85-103.",
    "sourceFile": "Problems/NPComplete/NPC_SAT3/SAT3_Class.cs",
    "wikiName": "",
    "defaultInstance": "(x1 | !x2 | x3) \u0026 (!x1 | x3 | x1) \u0026 (x2 | !x3 | !x1)",
    "instance": "(x1 | !x2 | x3) \u0026 (!x1 | x3 | x1) \u0026 (x2 | !x3 | !x1)",
    "instanceFormat": "Boolean formula in 3-CNF. Clauses joined by \u0027\u0026\u0027, literals within a clause joined by \u0027|\u0027, negation prefix \u0027!\u0027 written directly before the name. Variable names start with a letter or \u0027_\u0027 and contain only letters, digits and \u0027_\u0027. When there are several clauses, each clause with more than one literal must be in parentheses. Each clause has at most 3 literals. Example: (x1 | !x2 | x3) \u0026 (!x1 | x3 | x1)",
    "certificateFormat": "Comma-separated variable:Boolean pairs, optionally wrapped in parentheses. Booleans must be capitalized True/False (T/F also accepted); \u0027:\u0027 or \u0027=\u0027 may be used as the separator. List every variable you are assigning. Example: (x1:True,x2:False,x3:True)",
    "complexityClass": "NPComplete",
    "problemType": "Logic",
    "contributors": [
      "Kaden Marchetti"
    ],
    "defaultSolver": {
      "solverName": "3SAT Backtracking",
      "solverDefinition": "This is a O(2^n) solution algorithm for the 3SAT problem which implements a back tracking algorithm to find an exact assignment boolean assignment of variables to satisfy the problem instance.",
      "source": "",
      "sourceFile": "Problems/NPComplete/NPC_SAT3/Solvers/Sat3BacktrackingSolver.cs",
      "contributors": [
        "David Lindeman",
        "Kaden Marchetti"
      ],
      "timerHasExpired": false,
      "solverType": "Backtracking",
      "timeComplexity": {
        "Function": "2^n * |phi|",
        "Description": ", n = number of variables, |phi| = formula size",
        "VariableNames": [
          "n",
          "phi"
        ]
      },
      "spaceComplexity": null,
      "complexityBucket": "Exponential"
    },
    "defaultVerifier": {
