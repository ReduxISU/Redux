{
  "reductionName": "Garey-Johnson Reduction",
  "reductionDefinition": "Garey and Johnson Reduction converts 3SAT to a set of elements, and constraints of a 3-dimensional matching problem. The varibles are represented by wheels of 2 constraints for each clause a variable is in. The clauses are each mapped to a group of contraints all sharing two elements, with the third attaching to a varible gadget. Garbage collection gadgets are than created as constrains that assure any unincluded elements outside of the clause gadget are included in a matching.",
  "source": "Garey, M. R. and David S. Johnson. \u201CComputers and Intractability: A Guide to the Theory of NP-Completeness.\u201D (1978).",
  "sourceFile": "Problems/NPComplete/NPC_SAT3/ReduceTo/NPC_DM3/GareyJohnson.cs",
  "contributors": [
    "Caleb Eardley"
  ],
  "visualization": {
    "visualizationName": "3-Dimensional Matching Tripartite Visualization",
    "visualizationDefinition": "Draws X, Y and Z as three columns and each triple of M as a line through one element of each. A perfect matching picks triples that together use every element exactly once; a set of triples that uses an element twice fails.",
    "visualizationType": "DynamicTable",
    "source": "",
    "sourceFile": "Problems/NPComplete/NPC_DM3/Visualizations/DM3Visualization.cs",
    "contributors": [
      "Michael Trosper"
    ],
    "solver": {
      "solverName": "3-Dimensional Matching Brute Force",
      "solverDefinition": "This is a generic local search solver for 3-Dimensional Matching, which, while possible, removes one constraint from the current solution, and swaps in two more constraints.",
      "source": "",
      "sourceFile": "Problems/NPComplete/NPC_DM3/Solvers/ThreeDimensionalMatchingBruteForce.cs",
      "contributors": [
        "Caleb Eardley"
      ],
      "timerHasExpired": false,
      "solverType": "BruteForce",
      "timeComplexity": {
        "Function": "C(m, n) * n^2",
        "Description": ", m = |M| (candidate triples), n = |X| = |Y| = |Z|",
        "VariableNames": [
          "m",
          "n"
        ]
      },
      "spaceComplexity": null,
      "complexityBucket": "Exponential"
    }
  },
