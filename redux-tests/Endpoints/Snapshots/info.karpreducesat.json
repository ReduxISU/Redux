{"reductionName":"Karp\u0027s SAT Reduction","reductionDefinition":"Karp\u0027s reduction converts each clause from a 3CNF into an OR gadgets to establish the truth assignments using labels.","source":"http://cs.bme.hu/thalg/3sat-to-3col.pdf.","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/ReduceTo/NPC_SAT/KarpReduceSAT.cs","sourceLink":"http://cs.bme.hu/thalg/3sat-to-3col.pdf.","contributors":["Daniel Igbokwe"],"cost":"Cubic","reductionType":"ComponentDesign","reductionTypes":["ComponentDesign"],"complexityBucket":"Polynomial","complexity":"O(n^2)","reductionFrom":{"problemName":"Graph Coloring","problemLink":"https://en.wikipedia.org/wiki/Graph_coloring","formalDefinition":"GRAPHCOLORING = {\u003CG,k\u003E | G is a graph that has a k-coloring}","problemDefinition":"An assignment of labels (e.g., colors) to the vertices of a graph such that no two adjacent vertices are of the same label. This is called a vertex coloring.","inputDescription":"G, a graph, and k, the number of colors","outputDescription":"True or False, whether G has a valid k-coloring","source":"Karp, Richard M. Reducibility among combinatorial problems. Complexity of computer computations. Springer, Boston, MA, 1972. 85-103.","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/GRAPHCOLORING_Class.cs","sourceLink":"https://cgi.di.uoa.gr/~sgk/teaching/grad/handouts/karp.pdf","contributors":["Daniel Igbokwe","Alex Diviney"],"defaultInstance":"(({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)","instanceFormat":"Format: {((N,E),K) | N is set, E subset N unorderedcross N, K is int} Example: (({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)","certificateFormat":"Format: {c1,...,cK} | color classes partition N, no edge in E has both endpoints in the same class Example: {{a,f},{b,d},{c,e}}","instance":"(({a,b,c,d,e,f},{{a,b},{b,c},{c,a},{a,d},{b,e},{c,f},{d,e},{e,f},{f,d}}),3)","wikiName":"","defaultSolver":{"solverName":"Graph Coloring Brute Force","solverDefinition":"This is a brute force solver for the NP-Complete Graph Coloring problem","source":"","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/Solvers/GraphColoringBruteForce.cs","contributors":["Andrija Sevaljevic"],"timerHasExpired":false,"solverType":"BruteForce","solverTypes":["BruteForce"],"complexityBucket":"Exponential","timeComplexity":{"Function":"(numColors\u002B1)^n * n^2 * m","Description":", n = |nodes|, m = |edges|, numColors = min(K, n)","VariableNames":["numColors","n","m"]}},"defaultVerifier":{"verifierName":"Graph Coloring Solution Verifier","verifierDefinition":"This is a verifier for Graph Coloring.","source":"","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/Verifiers/GraphColoringVerifier.cs","contributors":["Andrija Sevaljevic"],"complexity":"","certificate":"","coloring":{},"k":0},"defaultVisualization":{"visualizationName":"Graph Coloring Visualization","visualizationDefinition":"This is a default visualization for Graph Coloring","source":"","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/Visualizations/GraphColoringDefaultVisualization.cs","contributors":["Andrija Sevaljevic","Russell Phillips"],"visualizationType":"GraphD3","visualizationTypes":["GraphD3"],"pictureType":"Graph","solver":{"solverName":"Graph Coloring Brute Force","solverDefinition":"This is a brute force solver for the NP-Complete Graph Coloring problem","source":"","sourceFile":"Problems/NPComplete/NPC_GRAPHCOLORING/Solvers/GraphColoringBruteForce.cs","contributors":["Andrija Sevaljevic"],"timerHasExpired":false,"solverType":"BruteForce","solverTypes":["BruteForce"],"timeComplexity":{"Function":"(numColors\u002B1)^n * n^2 * m","Description":", n = |nodes|, m = |edges|, numColors = min(K, n)","VariableNames":["numColors","n","m"]},"spaceComplexity":null,"complexityBucket":"Exponential"}},"graph":{"nodes":null,"edges":null,"Nodes":{},"Edges":{}},"complexityClass":"NPComplete","problemType":"GraphTheory","problemTypes":["GraphTheory"],"problemVariants":["