{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "QuantumSolver": {
    "BaseURL": "http://localhost:27100"
  },
  // The time limit, in seconds, of every compute request: solve, verify, reduce, visualize, mapSolution, gadgets and
  // visualizeReduction (#935), and in a worker process mapSolutionBack too (#991). A job that runs past it is stopped
  // and answers HTTP 422 with error "time_limit" (visualize instead draws the stopped run). Zero or less turns the limit off.
  // The older key "Visualization:SolveTimeLimitSeconds" (#885), if set, still decides the visualize limit.
  // MaxConcurrentJobs: how many of those jobs may run at once (#936). When all are in use, a new one is turned away at
  // once with HTTP 429 and error "server_busy". Unset means the number of processors (at least 2); zero or less turns
  // the cap off.
  // IsolateSolves: run each compute job (solve since #936; verify, reduce, mapSolution, mapSolutionBack, gadgets,
  // visualize and visualizeReduction since #991) in a worker process of its own, so a job that does not stop at the time
  // limit is killed (the computation is really cancelled) and a job can have a memory limit. The server keeps one warm
  // worker per job slot (MaxConcurrentJobs) started ahead of time. False runs every job inside the server, as before,
  // where the time limit only stops the server waiting. The name is from when only solves moved.
  // SolveMemoryMB: the memory limit, in megabytes, of a compute job (of any endpoint) in a worker. A job that needs more
  // answers HTTP 422 with error "memory_limit". Zero or less turns the limit off.
  "ComputeLimits": {
    "TimeLimitSeconds": 10,
    "IsolateSolves": true,
    "SolveMemoryMB": 512
  }
}
